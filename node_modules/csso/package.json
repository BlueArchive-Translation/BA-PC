{
  "name": "csso",
  "version": "5.0.5",
  "description": "CSS minifier with structural optimisations",
  "author": "Sergey Kryzhanovsky <skryzhanovsky@ya.ru> (https://github.com/afelix)",
  "maintainers": [
    {
      "name": "Roman Dvornov",
      "email": "rdvornov@gmail.com",
      "github-username": "lahmatiy"
    }
  ],
  "repository": "css/csso",
  "license": "MIT",
  "type": "module",
  "unpkg": "dist/csso.esm.js",
  "jsdelivr": "dist/csso.esm.js",
  "browser": {
    "./cjs/version.cjs": "./dist/version.cjs",
    "./lib/version.js": "./dist/version.js"
  },
  "main": "./cjs/index.cjs",
  "module": "./lib/index.js",
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./cjs/index.cjs"
    },
    "./syntax": {
      "import": "./lib/syntax.js",
      "require": "./cjs/syntax.cjs"
    },
    "./dist/*": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "css-tree": "~2.2.0"
  },
  "devDependencies": {
    "c8": "^7.10.0",
    "esbuild": "^0.14.54",
    "eslint": "^7.24.0",
    "mocha": "^9.2.2",
    "rollup": "^2.60.2",
    "source-map-js": "^1.0.1"
  },
  "engines": {
    "node": "^10 || ^12.20.0 || ^14.13.0 || >=15.0.0",
    "npm": ">=7.0.0"
  },
  "files": [
    "dist",
    "!dist/test",
    "cjs",
    "lib"
  ]
}